{
    "common": {
        "win11-x64": [
            "-DCMAKE_BUILD_TYPE=Release",
            "-DBUILD_SHARED_LIBS=OFF",
            "-DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreadedDLL",
            "-G",
            "NMake Makefiles"
        ]
    },
    "platform": {
        "win11-x64": [
            {
                "name": "simdjson",
                "version": "4.2.4",
                "cmake_args": [
                    "-DSIMDJSON_CXX_STANDARD=23"
                ]
            },
            {
                "name": "zlib",
                "version": "1.3.1"
            },
            {
                "name": "c-ares",
                "version": "1.34.6",
                "cmake_args": [
                    "-DCARES_SHARED=OFF",
                    "-DCARES_STATIC=ON",
                    "-DCARES_BUILD_TESTS=OFF",
                    "-DCARES_BUILD_TOOLS=OFF"
                ]
            },
            {
                "name": "nghttp2",
                "version": "1.68.0",
                "cmake_args": [
                    "-DBUILD_STATIC_LIBS=ON",
                    "-DBUILD_TESTING=OFF",
                    "-DENABLE_APPS=OFF",
                    "-DENABLE_EXAMPLES=OFF",
                    "-DENABLE_HPACK_TOOLS=OFF",
                    "-DENABLE_ASIO_LIB=OFF",
                    "-DENABLE_FAILMALLOC=OFF",
                    "-DENABLE_DEBUG=OFF"
                ]
            },
            {
                "name": "curl",
                "version": "8.17.0",
                "cmake_args": [
                    "-DNGHTTP2_STATICLIB=ON",
                    "-DCMAKE_C_FLAGS=/DNGHTTP2_STATICLIB",
                    "-DCURL_USE_SCHANNEL=ON",
                    "-DCURL_USE_OPENSSL=OFF",
                    "-DCURL_ENABLE_ARES=ON",
                    "-DCURL_DISABLE_LDAP=ON",
                    "-DCURL_USE_LIBPSL=OFF",
                    "-DBUILD_TESTING=OFF",
                    "-DBUILD_EXAMPLES=OFF",
                    "-DBUILD_CURL_EXE=OFF",
                    "-DBUILD_LIBCURL_DOCS=OFF",
                    "-DCARES_INCLUDE_DIR={{c-ares_DIR}}/include",
                    "-DCARES_LIBRARY={{c-ares_DIR}}/lib/cares.lib",
                    "-DNGHTTP2_INCLUDE_DIR={{nghttp2_DIR}}/include",
                    "-DNGHTTP2_LIBRARY={{nghttp2_DIR}}/lib/nghttp2.lib",
                    "-DZLIB_INCLUDE_DIR={{zlib_DIR}}/include",
                    "-DZLIB_LIBRARY={{zlib_DIR}}/lib/zlibstatic.lib"
                ]
            }
        ]
    }
}
